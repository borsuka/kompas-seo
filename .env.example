# -----------------------------------------------------------------------------
# Copy to `.env` in the repo root: `cp .env.example .env`
# Every app (web, api, worker) and package script loads this single root file.
# The defaults below work with `docker compose` and need NO external API keys.
# -----------------------------------------------------------------------------

# --- General ------------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Log level for pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Public URLs ----------------------------------------------------------------
# Public origin of the web app. The browser talks only to this origin; /api/* is
# proxied to the API server, so auth cookies are first-party.
APP_URL=http://localhost:3000
# Internal URL the Next.js server uses to reach the API (rewrites + SSR fetches).
API_INTERNAL_URL=http://localhost:4000
# Ports for the local processes.
WEB_PORT=3000
API_PORT=4000
WORKER_HEALTH_PORT=4001

# Host ports of the Docker services use uncommon numbers (15432, 18123, 16379,
# 11025, 18025) so they do not clash with other local projects. Override with
# POSTGRES_PORT, CLICKHOUSE_PORT, REDIS_PORT, SMTP_PORT, MAILPIT_UI_PORT.
MAILPIT_UI_PORT=18025

# --- PostgreSQL ------------------------------------------------------------------
# Users, organizations, projects, credits, jobs, audit log.
DATABASE_URL=postgres://seo:seo@localhost:15432/seo
# Used only by integration/E2E tests. Tests truncate this database.
TEST_DATABASE_URL=postgres://seo:seo@localhost:15432/seo_test

# --- ClickHouse ------------------------------------------------------------------
# Analytical data: keywords, SERP snapshots, rankings, backlinks, provider usage.
CLICKHOUSE_URL=http://localhost:18123
CLICKHOUSE_USER=seo
CLICKHOUSE_PASSWORD=seo
CLICKHOUSE_DATABASE=seo
# Database used by tests (created automatically by the migration runner).
CLICKHOUSE_TEST_DATABASE=seo_test

# --- Redis -----------------------------------------------------------------------
# Cache, BullMQ queues, rate limiting, job progress pub/sub.
REDIS_URL=redis://localhost:16379

# --- Auth (Better Auth) ----------------------------------------------------------
# Secret used to sign sessions/tokens. Generate: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=change-me-dev-secret-at-least-32-characters-long
# Require email verification before sign-in (true in production).
AUTH_REQUIRE_EMAIL_VERIFICATION=true
# Google OAuth. Leave empty to hide "Continue with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (SMTP) ----------------------------------------------------------------
# Defaults point to Mailpit (UI: http://localhost:18025).
SMTP_HOST=localhost
SMTP_PORT=11025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM="Kompas SEO <no-reply@kompas.local>"

# --- Encryption --------------------------------------------------------------------
# 32-byte key, base64-encoded, for AES-256-GCM encryption of OAuth tokens at rest.
# Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# --- Data providers ----------------------------------------------------------------
# Which implementation serves each data type: mock | dataforseo
# `mock` returns deterministic realistic data and needs no keys.
KEYWORD_PROVIDER=mock
SERP_PROVIDER=mock
DOMAIN_PROVIDER=mock
BACKLINK_PROVIDER=mock
# DataForSEO credentials (https://app.dataforseo.com/api-access). Required only
# when one of the providers above is `dataforseo`.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Use the free DataForSEO sandbox (sandbox.dataforseo.com) instead of live API.
DATAFORSEO_SANDBOX=false
# Optional JSON override of credit costs per operation, e.g. {"serp.get":5}
CREDIT_COSTS_JSON=

# --- AI (Anthropic Claude) --------------------------------------------------------
# Used to classify search intent for ambiguous keywords (and, later, content briefs).
# Leave empty to rely on the built-in BG/EN intent rules only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Billing -------------------------------------------------------------------------
# Stripe integration is disabled unless this is true (Phase 6).
BILLING_ENABLED=false

# --- Rate limiting -------------------------------------------------------------------
# Requests per minute per IP for the REST API.
RATE_LIMIT_PER_MINUTE=300

# --- Observability ---------------------------------------------------------------------
# Optional. Leave empty to disable Sentry.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
